# What a release APK must be. Edited DELIBERATELY with each release; release-build and
# android-release assert the finished APK against these, independently of build.gradle.
# SIGNER_SHA256 is the sha256 of the v2 signer certificate of the previously published
# APK (shramsafal-latest.apk = 1.0.14/22, built from 60dcf51a; signer unchanged - same as 1.0.13/21 from 8f1c9c22
# and 1.0.12/20 from b33403a). It also signed 1.0.11 and
# the first rotated-key build (220270d); the pre-rotation key (de6277b1...) is NOT valid.
APP_ID=com.agrisync.shramsafal
VERSION_NAME=1.0.15
VERSION_CODE=23
PREVIOUS_VERSION_CODE=22
SIGNER_SHA256=3b3f860b6faa4d132497b8d799a615c78c55cb7a18323a972d3d9e5d250aa33d
