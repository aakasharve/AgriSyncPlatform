<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ShramSafal.Domain\ShramSafal.Domain.csproj" />
    <ProjectReference Include="..\..\..\AgriSync.SharedKernel\AgriSync.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\AgriSync.BuildingBlocks\AgriSync.BuildingBlocks.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- W1.P0 Batch A (ai-intelligence-plan-2026-06-25 Task 8 fix) — expose
       internal members (ParseVoiceInputHandler.ApplyTranscriptIntegrityCorrections)
       to the Domain.Tests project so the REAL flag-branching path is testable
       with both flag states. Mirrors the InternalsVisibleTo pattern the
       Infrastructure assembly already uses. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ShramSafal.Domain.Tests" />
  </ItemGroup>

  <!-- T-IGH-02-CS-PAYLOADS — single source of truth for sync mutation
       payloads. Generated from sync-contract/schemas/payloads/*.zod.ts
       by `npm run generate:csharp` (Zod runtime introspection → C#).
       Linked rather than copied so the on-disk files live next to the
       Zod schemas they're generated from. Regenerate after every Zod
       change via `cd sync-contract && npm run generate`. -->
  <ItemGroup>
    <Compile Include="..\..\..\..\sync-contract\schemas\payloads-csharp\*.cs">
      <Link>Contracts\Sync\Payloads\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <!-- spec: plr-d10 lane L8b-1 — the crop master's names (generated from the phone's cropMasterData.ts by
       sync-contract/scripts/generate-crop-names.ts), so ScheduleLibrary reads a crop name exactly as the phone's
       schedule library does. Linked, never copied: one file. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\sync-contract\schemas\crop-names.json">
      <LogicalName>ShramSafal.Application.CropNames.json</LogicalName>
      <Link>Services\CropNames.json</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
