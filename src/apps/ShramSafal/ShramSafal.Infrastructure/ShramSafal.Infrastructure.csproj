<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin: transitive Pkcs 9.0.0/10.0.11 is affected by CVE-2026-70162 (GHSA-2fmv-rv2c-59x7); patched 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="FFMpegCore" Version="5.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- spec: data-principle-spine-2026-05-05/03.1 — design-time factory reads
         appsettings.json + appsettings.Development.json to resolve the
         ShramSafalDb_Migration connection string for `dotnet ef` invocations. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.18.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.2.1" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShramSafal.Application\ShramSafal.Application.csproj" />
    <ProjectReference Include="..\ShramSafal.Domain\ShramSafal.Domain.csproj" />
    <ProjectReference Include="..\..\..\AgriSync.SharedKernel\AgriSync.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\AgriSync.BuildingBlocks\AgriSync.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AI\Prompts\**\*.md" />
    <!-- spec: data-principle-spine-2026-05-05/10.1 — heuristic PII name dictionary. -->
    <EmbeddedResource Include="Privacy\Resources\*.txt" />
  </ItemGroup>

  <!-- spec: plr-d10 lane DFES-Q (founder D-B, D-G) - Shram Safal's own published schedule, as DFES reads it (look lines and their
       sources, projected by sync-contract/scripts/project-dfes-schedule.mjs). Linked, never copied: the phone reads the same file.
       ScheduleSourceResolver turns the line ids a phone names into the sources those lines carry. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\sync-contract\schedules\*.dfes.json">
      <LogicalName>ShramSafal.Infrastructure.Schedules.%(Filename)%(Extension)</LogicalName>
      <Link>AI\Dfes\Schedules\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
