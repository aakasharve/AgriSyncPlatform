<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Accounts.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <!--
      Pin transitive System.Security.Cryptography.Xml. EF/Npgsql pulls the
      vulnerable 9.0.0 otherwise. Mirrors ShramSafal + User Infrastructure.

      2026-08-23: bumped 10.0.6 -> 10.0.11. The 10.0.6 pin was ITSELF the fix
      for GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf, and 10.0.6 has since
      acquired GHSA-cvvh-rhrc-wg4q. A pinned "patched" version is a claim with
      an expiry date, so re-check it rather than trusting the word patched.

      Reachability, measured before bumping: the vulnerable surface
      (SignedXml / EncryptedXml / XmlDsig) is referenced in NO production file
      in this repo. The bump was taken anyway because it is a stable patch-level
      move and this assembly ships to production - not because exploitation was
      demonstrated.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accounts.Application\Accounts.Application.csproj" />
    <ProjectReference Include="..\Accounts.Domain\Accounts.Domain.csproj" />
    <ProjectReference Include="..\..\..\AgriSync.SharedKernel\AgriSync.SharedKernel.csproj" />
    <ProjectReference Include="..\..\..\AgriSync.BuildingBlocks\AgriSync.BuildingBlocks.csproj" />
  </ItemGroup>

</Project>
