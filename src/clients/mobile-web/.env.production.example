# Mobile-web production build-time env (Vite).
# All VITE_* vars are PUBLIC — they are inlined into the client bundle at build
# time. Do NOT put secrets here. Copy this file to `.env.production` for a prod
# build; the real `.env.production` is gitignored (see CTO debt #10, 2026-06-26).
VITE_AGRISYNC_API_URL=https://api.shramsafal.in

# Google Maps JavaScript API key — REQUIRED for the farm-boundary map + GPS.
# Without it, the map renders a "Map unavailable in this build" fallback.
# Public client key (protected by HTTP-referrer restrictions in Google Cloud
# Console — allow app.shramsafal.in, capacitor://localhost, https://localhost).
# For local prod builds put the value in the gitignored .env.production (or
# .env.local); CI/APK builds read it from the GitHub Actions secret of the same
# name (see .github/workflows/android-release.yml).
VITE_GOOGLE_MAPS_API_KEY=

# --- DFES / Shram Sathi companion (Track C) -------------------------------
# All default OFF. Set to 1 ONLY after the Founder Acceptance Gate is ticked.
# Turning these on is what makes the companion visible to farmers.
#
# Corrected 2026-08-15 (deploy-readiness task 8, fix round 1): all seven are
# read via the isEnabled('VITE_...') helper in
# src/clients/mobile-web/src/app/featureFlags.ts (lines 47, 55, 61, 63, 73,
# 83, 94) — reproduce with `grep -n "isEnabled('VITE_"
# src/clients/mobile-web/src/app/featureFlags.ts`. See task-8-report.md for
# the earlier incorrect claim (checked the wrong checkout) and its correction.
VITE_UNDERSTANDING_METER=0
VITE_STAGE_QUESTIONS=0
VITE_DISCIPLINE_SYSTEM=0
VITE_VOICE_CONTINUITY=0
VITE_DAILY_LOOP=0
VITE_INTELLIGENCE_INSIGHTS=0
VITE_TASK_CLOSE_CONFIRM=0

# --- DFES companion: remaining flags (spec: dfes-companion-2026-07-11) ----
# Verified 2026-08-16 (task 0.4, wave-0.4): the block above documents 7 of
# 11 companion-adjacent flags in featureFlags.ts. These 4 were missing from
# this template entirely; code counts (26 read / 9 in template / 17
# missing) were independently re-measured and match.

# Task 7 (featureFlags.ts:106) — daily 7am native local-notification nudge.
# Default OFF; gated behind its own real-device verification, separate from
# the Founder Acceptance Gate above. OFF = no permission prompt, no
# scheduled notification (byte-equivalent no-op).
VITE_MORNING_NOTIFICATION=0

# Task 8 (featureFlags.ts:119) — one spoken Marathi line on the 25-rich-day
# unlock. Default OFF; gated behind real-device mr-IN voice verification.
# OFF = the speak effect returns immediately: no speak, no localStorage write.
VITE_SPOKEN_UNLOCK_REWARD=0

# Founder decision 2026-07-19 (featureFlags.ts:136) — pauses the rich-day
# unlock counter. DANGEROUS WHEN UNSET: absent/0 means the counter that was
# deliberately paused comes back. Ship =1 for any build that also turns
# VITE_UNDERSTANDING_METER on. The android-release.yml workflow already
# hardcodes this to 1 independently of this file (APK builds don't read it).
VITE_UNLOCK_COUNTER_PAUSED=1

# Dev test-ground only (featureFlags.ts:148) — forces the post-unlock
# display state without waiting 25 real days. Never writes to the server,
# never fabricates rich days. MUST stay 0 in production.
VITE_SIMULATE_UNLOCK=0

# --- Dead flags — documented, not wired to any production consumer -------
# Read via the isEnabled() helper (featureFlags.ts:13-17) but the exported
# functions (isFarmGeographyV2Enabled, isWeatherBackendFetchEnabled) have
# zero production call sites — only test mocks reference them. Left unset
# intentionally; per the task-0.4 brief, do NOT add either to the
# android-release.yml workflow. Revisit if a real consumer appears.
VITE_FARM_GEOGRAPHY_V2=
VITE_WEATHER_BACKEND_FETCH=

# --- Voice doom-loop detector (featureFlags.ts:19-20) ---------------------
# INVERTED DEFAULT — protection is ENABLED by default when this is unset.
# Only '0' / 'false' / 'off' / 'no' turn it OFF. NEVER write "=0" here;
# either omit the line entirely or set =1. Spelled out explicitly so a
# future edit doesn't silently ship doom-loop protection disabled.
VITE_VOICE_DOOM_LOOP_DETECTOR=1

# --- Misc dev/CI flags -----------------------------------------------------
# DWC v2 chip (featureFlags.ts:38-39) — ON automatically whenever
# `MODE === 'development'`; this override only matters for a prod-mode
# preview build. Default 0 in production.
VITE_DWC_CHIP=0

# E2E test-harness route (featureFlags.ts:27). Set to 1 only in CI's E2E
# job; must be absent/0 in production and APK builds.
VITE_E2E_HARNESS=0

# --- Observability ----------------------------------------------------------
# Sentry DSN (src/lib/sentry.ts:39). Treated as a secret in CI (GitHub
# Actions secret of the same name — see runbook
# _COFOUNDER/runbooks/secrets-mgmt.md). Leave blank here; unset/blank means
# Sentry stays fully disabled (no events sent), a safe default for a local
# prod build.
VITE_SENTRY_DSN=

# Build/release version tag, normally set by the CI pipeline
# (lib/sentry.ts:51, infrastructure/observability/OtelBrowserSdk.ts:59).
# Falls back to "dev" / "0.0.0" respectively when unset. Leave blank for
# local builds.
VITE_APP_VERSION=

# Allows Sentry events while running `vite dev` (lib/sentry.ts:59). Only
# read when import.meta.env.DEV is true, so it has no effect on a real
# production build; documented for completeness. Default 0.
VITE_SENTRY_DEV_ENABLED=0

# Browser OpenTelemetry tracing (index.tsx:8, OtelBrowserSdk.ts). MUST stay
# unset or "0" in production until a production OTLP collector is
# provisioned — see the "Production notes" comment in OtelBrowserSdk.ts.
VITE_OTEL_ENABLED=0

# OTLP trace exporter endpoint (OtelBrowserSdk.ts:68). Only consulted when
# VITE_OTEL_ENABLED=1. Falls back to http://localhost:4318/v1/traces when
# unset — a local-only default, irrelevant while OTel stays off.
VITE_OTEL_ENDPOINT=

# Distinct from VITE_AGRISYNC_API_URL — used only to decide whether the
# OTel fetch/XHR instrumentation attaches a traceparent header to a given
# request URL (OtelBrowserSdk.ts:92). Falls back to http://localhost:5000
# when unset; irrelevant while OTel stays off.
VITE_API_BASE_URL=

# Chain-of-Verification wrapper toggle (infrastructure/ai/CoVeWrapper.ts:48).
# NOTE: compares against the literal string "true", not "1"/"on"/"yes" like
# the isEnabled() flags above. Leave unset/blank to keep CoVe off.
VITE_COVE_ENABLED=

# Short build SHA shown in the red AI-test-mode banner
# (shared/components/AiTestModeBanner.tsx:30). Falls back to "dev" when
# unset. Cosmetic only — safe to leave blank.
VITE_BUILD_SHA=
