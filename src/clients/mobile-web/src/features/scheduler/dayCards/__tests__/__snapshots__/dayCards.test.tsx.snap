exports[`one snapshot per kind of work > irrigation: the cards of the work are drawn as approved 1`] = `"<section data-testid="day-card" data-card-type="hero" class="mx-auto flex min-h-full w-full max-w-md snap-start snap-always flex-col gap-3 px-4 py-4"><div class="flex flex-1 flex-col gap-3 rounded-[28px] bg-white p-4 shadow-sm" style="box-shadow:0 0 0 2px #0E7490 inset"><div class="flex flex-wrap items-center gap-2"><span data-testid="kind-chip" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-extrabold" style="background:#A5F3FC;color:#0E7490">पाणी</span><span data-testid="timing-chip" class="inline-flex min-h-[28px] items-center rounded-full px-3 text-[13px] font-extrabold" style="background:#F5F5F4;color:#44403C">दिवस १०</span></div><div class="grid h-[150px] place-items-center rounded-3xl" style="background:#CFFAFE;color:#0E7490" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-droplets" aria-hidden="true"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"></path><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"></path></svg></div><h2 class="text-[26px] font-black leading-tight text-stone-900">पाणी द्या</h2><p class="text-[17px] font-semibold leading-snug text-stone-700">नव्या फुटव्यांना पाणी लागतं</p><div data-testid="dose-box" class="rounded-2xl bg-stone-100 p-3"><div class="mb-1 last:mb-0"><p data-testid="dose-text" class="text-[22px] font-black leading-tight text-stone-900">२०,४०० लिटर प्रति दिवस</p><p data-testid="dose-state" class="mt-1 text-[13px] font-extrabold text-emerald-800">तपासलेली मात्रा</p></div></div></div></section><section data-testid="day-card" data-card-type="source" class="mx-auto flex mi