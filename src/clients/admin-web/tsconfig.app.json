{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // vitest.config.ts sets `globals: true`, so test files use bare
    // describe/it/expect. tsconfig.app.json includes "src", which means
    // `tsc -b` (the first half of `npm run build`) type-checks those files —
    // without this entry the first test written breaks the production build,
    // not the test run. `@testing-library/jest-dom/vitest` (imported in
    // src/test/setup.ts) augments the same Assertion interface, so the
    // DOM matchers resolve through it too.
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path alias — no baseUrl needed in modern TS */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
